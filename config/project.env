# Spatial Query Processing on Mumbai OpenStreetMap Data Using PostgreSQL/PostGIS
# Shell-readable configuration: no Python or password file is required.
DB_NAME=mumbai_spatial_db
DB_HOST=127.0.0.1
DB_PORT=5433
# Defaults to the current OS user when unset (see scripts/common.sh).
DB_USER=
DB_SSLMODE=prefer

# Source: official OpenStreetMap planet snapshot published by the OpenStreetMap
# Foundation on the AWS Open Data Registry (bucket osm-pds). The planet is
# streamed through osmium and never stored locally; only the Mumbai clip is kept.
PLANET_URL=https://osm-pds.s3.amazonaws.com/2026/planet-260928.osm.pbf
PLANET_MD5_URL=https://osm-pds.s3.amazonaws.com/2026/planet-260928.osm.pbf.md5
# Stage 1 (single streaming pass, simple strategy): generous buffer box.
BUFFER_BBOX=72.50,18.70,73.30,19.50
# Stage 2 (complete ways + complete boundary/multipolygon relations):
# Greater Mumbai (Mumbai City + Mumbai Suburban districts) plus a small margin.
# Format: west,south,east,north in EPSG:4326 longitude/latitude.
MUMBAI_BBOX=72.75,18.85,73.05,19.30
BUFFER_PATH=data/raw/mumbai_buffer.osm.pbf
DATASET_PATH=data/raw/mumbai.osm.pbf
IMPORT_CACHE_MB=1024
IMPORT_PROCESSES=4
